---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const channels = [
	{ label: 'Email', value: 'hello@example.com', href: 'mailto:hello@example.com' },
	{ label: 'GitHub', value: 'github.com/withastro', href: 'https://github.com/withastro' },
	{ label: 'Mastodon', value: '@astro@m.webtoo.ls', href: 'https://m.webtoo.ls/@astro' },
];

const title = 'Contact';
const description = '欢迎通过以下任意方式与我联系。';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.intro {
				color: rgb(var(--gray));
			}
			dl {
				margin: 2rem 0 0 0;
			}
			.row {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				padding: 1rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			dt {
				width: 6rem;
				flex-shrink: 0;
				font-weight: 700;
				color: rgb(var(--black));
			}
			dd {
				margin: 0;
			}
			.note {
				margin-top: 2rem;
				padding: 1.25rem;
				border-left: 4px solid var(--accent);
				background: rgba(var(--gray-light), 40%);
				border-radius: 0 8px 8px 0;
				font-size: 0.95rem;
			}
			@media (max-width: 720px) {
				.row {
					flex-direction: column;
					gap: 0.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<p class="intro">{description}</p>
			<dl>
				{channels.map((channel) => (
					<div class="row">
						<dt>{channel.label}</dt>
						<dd>
							<a href={channel.href} target="_blank" rel="noopener noreferrer">
								{channel.value}
							</a>
						</dd>
					</div>
				))}
			</dl>
			<p class="note">
				这是一个静态站点，没有后端接口，因此页面上不提供提交表单。若需要留言，请直接发邮件。
			</p>
		</main>
		<Footer />
	</body>
</html>
