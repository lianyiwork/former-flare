---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404 Not Found" description="你访问的页面不存在。" />
		<style>
			main {
				text-align: center;
			}
			.code {
				font-size: 6rem;
				line-height: 1;
				margin: 0;
				color: var(--accent);
			}
			.lead {
				color: rgb(var(--gray));
			}
			.links {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.75rem;
				list-style: none;
				margin: 2rem 0 0 0;
				padding: 0;
			}
			.links a {
				display: inline-block;
				padding: 0.5rem 1.1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				text-decoration: none;
			}
			.links a:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="code">404</p>
			<h1>页面走丢了</h1>
			<p class="lead">你访问的地址不存在，或者已经被移动到了别处。</p>
			<ul class="links">
				<li><a href="/">返回首页</a></li>
				<li><a href="/blog/">浏览文章</a></li>
				<li><a href="/search/">搜索内容</a></li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
